# Copy to `.env` (which is gitignored) and fill in your play character.
# The first character you create in a fresh world becomes admin — do NOT
# use that one here. Create a separate mortal character to explore with.
# See week0_explore/HOW_TO_PLAY.md.

MUD_NAME=dummy
MUD_PASSWORD=helloworld

# Optional — defaults shown.
MUD_HOST=localhost
MUD_PORT=4000
MUD_QUIET=1.0
MUD_TIMEOUT=10
